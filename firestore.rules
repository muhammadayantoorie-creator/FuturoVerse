rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Application data is accessed only by the trusted Express backend via the
    // Firebase Admin SDK, which bypasses these client rules. Never expose the
    // aggregate application document to browser clients.
    match /app/{document=**} {
      allow read, write: if false;
    }

    // Browser clients must not create or alter role-bearing profile documents.
    // Profiles are provisioned by the trusted backend/Admin SDK.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
