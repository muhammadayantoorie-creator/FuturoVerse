# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Public API URL prefix for frontend (optional, fallback to empty string / relative path)
VITE_API_URL=""

# JWT Secrets for session token verification
JWT_SECRET="generate_a_secure_random_string_for_access_token_signing"
JWT_REFRESH_SECRET="generate_a_secure_random_string_for_refresh_token_signing"

# Set to true only for a separate frontend and API on different HTTPS origins.
CROSS_SITE_COOKIES="false"

# Keep false in production. Teachers should be provisioned by an administrator.
ALLOW_PUBLIC_TEACHER_REGISTRATION="false"

# Server-only Firebase service-account JSON. Required to verify Firebase email
# and Google ID tokens on the backend (especially in Vercel/Cloud Run). Never
# expose this value to the browser or commit it to the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=""
