# Required: Gemini AI API Key for AI features
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# App URL (used for OAuth callbacks, self-referential links)
APP_URL="http://localhost:3000"

# Public API URL prefix for frontend (leave empty for same-origin/relative paths)
VITE_API_URL=""

# JWT Secrets — MUST be at least 32 characters each in production!
JWT_SECRET="replace-with-a-random-32-char-secret-in-production"
JWT_REFRESH_SECRET="replace-with-a-random-32-char-refresh-secret-in-production"

# Cross-site cookie setting
CROSS_SITE_COOKIES="false"

# Set to "true" to allow teachers to self-register
ALLOW_PUBLIC_TEACHER_REGISTRATION="true"

# Server-only Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Node environment
NODE_ENV="development"
